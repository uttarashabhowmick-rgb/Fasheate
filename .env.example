# Copy to .env and fill in. Everything is optional: without keys the app runs in clearly-labelled demo mode.

# PayPal Sandbox REST app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID= 
PAYPAL_CLIENT_SECRET= 
# FREE option: Google Gemini key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY= 
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # used for the photoreal preview

# Optional paid option: Anthropic API key for design interpretation (https://console.anthropic.com)
ANTHROPIC_API_KEY= 
# ANTHROPIC_MODEL=claude-sonnet-5-5

# PORT=3000

# --- Real product recommendations (Step 2: "where to buy each material") ---
# Channel3 product search API key
CHANNEL3_API_KEY= 
# --- Photoreal "see it in real life" preview (Step 3) ---
# Stability AI key (https://platform.stability.ai/account/keys). Used first if set; otherwise Gemini is used.
STABILITY_API_KEY= 
# STABILITY_CONTROL_STRENGTH=0.7   # 0-1: higher sticks closer to your drawing, lower looks more like a photo
